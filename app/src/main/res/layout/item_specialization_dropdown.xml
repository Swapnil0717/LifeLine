<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_62sdp"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_12sdp">

    <TextView
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:background="@drawable/sos_button_bg"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/primaryRed"
        android:textSize="@dimen/_18sdp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSpecializationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="General Medicine"
            android:textColor="#0D2A4E"
            android:textSize="@dimen/_13sdp" />

        <TextView
            android:id="@+id/tvSpecializationSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/poppins_bold"
            android:text="Fever, BP, diabetes, infection"
            android:textColor="#888888"
            android:textSize="@dimen/_9sdp" />
    </LinearLayout>

</LinearLayout>